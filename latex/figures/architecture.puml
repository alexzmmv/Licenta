@startuml architecture

skinparam DefaultFontName Helvetica
skinparam DefaultFontSize 11
skinparam BackgroundColor White
skinparam ArrowColor #444444
skinparam ArrowThickness 1.2

skinparam rectangle {
  BackgroundColor #EEF2F7
  BorderColor #5A7FA8
  FontSize 10
  RoundCorner 6
}

skinparam package {
  BackgroundColor #FAFCFF
  BorderColor #8AACCC
  FontSize 11
  FontStyle bold
  RoundCorner 8
}

top to bottom direction

package "UI Layer  (SwiftUI)" as UILayer {
  rectangle "Dashboard    Calendar    Graph View    Entry Editor    Settings" as UI
}

package "Repository Layer" as RepoLayer {
  rectangle "LocalJournalRepository\nobserve · query · write" as Repo
}

package "Service Layer" as ServiceLayer {
  rectangle "AIProcessingManager\ntext flatten → safety → embed → emotion → persist → cluster" as APM

  package "Core ML Inference Engine" as CoreMLPkg {
    rectangle "EmbeddingService\nMiniLM-L6-v2 (384d)  ·  Nomic-v1.5 (256d / 768d)  ·  Apple NLEmbedding (512d)" as Emb
    rectangle "EmotionService\nMobileBERT · GoEmotions 12-class" as Emo
  }

  rectangle "DBSCANClusterer\nadaptive ε · cosine distance · silhouette calibration" as DBSCAN
  rectangle "SafetyFilter\non-device keyword scan" as Safety
}

package "Persistence  (SwiftData)" as PersistLayer {
  rectangle "Bit  ·  Cluster  ·  Settings" as DB
}

UI       -down->  Repo   : "read / create / edit entries"
Repo     -down->  APM    : "trigger AI pipeline"
APM      -down->  Emb    : "generateEmbedding(text)"
APM      -down->  Emo    : "detectEmotions(text)"
APM      -down->  Safety : "checkSafety(text)"
APM      -down->  DBSCAN : "clusterEntries(embeddings)"
APM      -down->  DB     : "write embedding, emotion, cluster"
Repo     -down->  DB     : "fetch entries"
DB       -up-->   Repo   : "@Query / observed changes"

@enduml
