{"nodes": [{"id": "docs_planning_plan_production_mvp_plan", "label": "GJournal Production-Ready Innovative MVP Plan", "file_type": "document", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_phase_1_harden", "label": "Phase 1 \u2014 HARDEN (foundation)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_phase_2_innovate", "label": "Phase 2 \u2014 INNOVATE (the paid product)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_phase_3_ship", "label": "Phase 3 \u2014 SHIP", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_pbkdf2_pin_authentication", "label": "PBKDF2 PIN Authentication with Escalating Lockout", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain SHA-256 cannot protect a 4-6 digit PIN keyspace against offline brute force; CommonCrypto CCKeyDerivationPBKDF with ~210k-350k iterations plus a 16-byte salt adds friction, and a Keychain-persisted escalating lockout is the real operational safeguard since no KDF fully secures a trivial keyspace."}, {"id": "docs_planning_plan_schema_migration_plan", "label": "SchemaVersions / GJournalMigrationPlan", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default wipe-store-and-recreate fallback silently destroys a user's entire psychological history on migration failure; it is replaced by StoreRecoveryView offering retry or raw-store export."}, {"id": "docs_planning_plan_store_recovery_view", "label": "StoreRecoveryView (no silent data loss)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_versioned_json_export", "label": "Versioned JSON Export/Import", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Embedding formatVersion/schemaVersion/appVersion gives an independent backup, cross-device portability, and satisfies GDPR data-portability requirements."}, {"id": "docs_planning_plan_hdbscan_clusterer", "label": "HDBSCANClusterer (Swift)", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DBSCAN's single global epsilon fails on variable-density semantic embeddings; HDBSCAN uses mutual reachability distance, an MST, a condensed tree, and EOM stability extraction. Chosen quality-first (V 0.737 vs DBSCAN 0.477) with the Python harness as correctness oracle and DBSCAN kept as a protocol-level fallback."}, {"id": "docs_planning_plan_mutual_reachability_distance", "label": "Mutual Reachability Distance", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_soft_cluster_assignment", "label": "Bayesian Soft Assignment of Semantic Noise (GLOSH)", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard HDBSCAN can label 60%+ of high-dimensional points as noise; combining exemplar distance membership with GLOSH outlier membership softly assigns periphery entries so only genuine isolates land in Unsorted."}, {"id": "docs_planning_plan_ggm_estimator", "label": "GGMEstimator (psychological network, Pillar A)", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Labeled honestly as \"shrinkage + thresholded partial correlation network\", not EBICglasso: a true graphical lasso in Swift is a 2+ week numerical project with convergence pitfalls and identical insight semantics, which are always associative and never causal."}, {"id": "docs_planning_plan_ledoit_wolf_shrinkage", "label": "Ledoit-Wolf Shrinkage", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When variable count approaches observation count the sample covariance is ill-conditioned; a convex combination with a stable diagonal target yields an invertible matrix whose inverse can be trusted."}, {"id": "docs_planning_plan_fdr_association_network", "label": "Tier 1 FDR-Controlled Association Network", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At small n, conditional independencies are unstable, so pairwise Spearman/Phi associations are filtered by Benjamini-Hochberg FDR q=0.10 plus an 8-of-10 bootstrap survival rule to prevent a spurious hairball graph."}, {"id": "docs_planning_plan_persistent_homology", "label": "PersistentHomology (Vietoris-Rips B0/B1, Pillar B)", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact union-find B0 and Z/2 boundary-matrix-reduction B1 for windows of at most 60 points (~1,770 edges / ~34k triangles) is tractable on-device, avoiding a Ripser C++ bridge; validated against giotto-tda/Ripser fixtures."}, {"id": "docs_planning_plan_loop_persistence_rumination", "label": "Loop Persistence (LP) as Rumination Proxy", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_flare_index", "label": "Flare Index (FI) as Exploration Proxy", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_semantic_recovery_velocity", "label": "Semantic Recovery Velocity (SRV)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surfaced as \"distance gained from difficult moments\" rather than \"recovery\" to keep wellness framing and avoid clinical claims."}, {"id": "docs_planning_plan_permutation_null_test", "label": "Permutation Null Hypothesis Safeguard (200 shuffles)", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TDA finds loops in pure noise; shuffling time while preserving spatial covariance builds a null distribution, and insights surface only above the 95th percentile. This gate is the primary defense against algorithmic apophenia and must not be cut for speed."}, {"id": "docs_planning_plan_trajectory_service", "label": "TrajectoryService (sliding 30-day windows)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_hybrid_search_service", "label": "HybridSearchService (BM25 + vector, RRF k=60)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brute-force SIMD cosine is sub-millisecond at journal scale, so no sqlite-vec dependency is needed; storage stays as SwiftData blobs."}, {"id": "docs_planning_plan_behavioral_tag_substrate", "label": "Behavioral Tags Shared Substrate (SchemaV2)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tags are canonicalized by embedding cosine >= 0.85 and only become GGM variables at >=5 occurrences; a Settings management UI mitigates junk-tag risk."}, {"id": "docs_planning_plan_entitlement_manager", "label": "EntitlementManager (StoreKit 2, on-device JWS)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A one-time non-consumable with on-device JWS validation needs no server, matching the privacy pitch and the consumer backlash against subscription fatigue."}, {"id": "docs_planning_plan_freemium_gating", "label": "Freemium Gating of the Three Insight Pillars", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Journaling, dashboard, calendar, clusters and plain keyword search stay free; only the three insight pillars are paid, and crisis resources are never paywalled."}, {"id": "docs_planning_plan_crisis_safety_filter", "label": "SafetyFilter + CrisisResourcesView", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A non-blocking, non-moralizing banner that only surfaces external resources keeps the app a supportive tool rather than a clinical intervention; saving is never blocked."}, {"id": "docs_planning_plan_eu_mdr_samd_boundary", "label": "EU MDR Software-as-a-Medical-Device Boundary", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automating PHQ-9-style scoring, risk triage, or therapeutic recommendation would trigger Class IIa/IIb obligations under MDR Rule 11; associative-only phrasing and wellness framing keep GJournal a general wellness product."}, {"id": "docs_planning_plan_eu_ai_act_compliance", "label": "EU AI Act Article 5(1)(f) / Article 50(3) Position", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An emotion recognition system requires biometric data under Article 3(39); inferring emotion from written text is not biometric processing, so the workplace/education prohibition does not apply, but Article 50(3) transparency is still met via onboarding disclosure."}, {"id": "docs_planning_plan_goemotions_validation", "label": "GoEmotions Classifier Validation and Binarization", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classes with per-class F1 below ~0.45 are excluded from network variables, and softmax outputs are binarized at the user's historical median because compositional probabilities force artificial negative correlations between emotion classes."}, {"id": "docs_planning_plan_emotion_quantization", "label": "Emotion Classifier Quantization (94MB to ~25MB)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_dead_model_cleanup", "label": "Dead Model Cleanup (Nomic / MobileBERT removal)", "file_type": "rationale", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing the Nomic enum cases would crash on deserializing the stale @AppStorage(\"embeddingModelChoice\") default of nomicMRL, so the binding is deleted entirely in favor of reading EmbeddingModelChoice.current."}, {"id": "docs_planning_plan_stoic_competitor", "label": "Stoic (quantitative habit-tracker competitor)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_plan_rosebud_competitor", "label": "Rosebud (generative-AI wellness competitor)", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as the privacy liability contrast case: journal text is transmitted to third-party LLM providers, which GJournal's on-device architecture entirely avoids."}, {"id": "docs_planning_plan_ubb_data_lab_partnership", "label": "Babes-Bolyai University DATA Lab Partnership", "file_type": "concept", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permutation testing validates internally but only a clinical partnership can link FI/SRV to psychometrics like PHQ-9 and GAD-7."}, {"id": "docs_planning_plan_topology_of_recovery_citation", "label": "Chandra et al., The Topology of Recovery", "file_type": "paper", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Chandra et al.", "contributor": null}, {"id": "docs_planning_plan_risk_register", "label": "Risk Register and Cut Order", "file_type": "document", "source_file": "docs/planning/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_planning_plan_production_mvp_plan", "target": "docs_planning_plan_phase_1_harden", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/planning/plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_planning_plan_production_mvp_plan", "target": "docs_planning_plan_phase_2_innovate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/planning/plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_planning_plan_production_mvp_plan", "target": "docs_planning_plan_phase_3_ship", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/planning/plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_planning_plan_production_mvp_plan", "target": "docs_planning_plan_risk_register", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/planning/plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_planning_plan_phase_1_harden", "target": "docs_planning_plan_schema_migration_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/planning/plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_planning_plan_phase_1_harden", "target": "docs_planning_plan_pbkdf2_pin_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/planning/plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_planning_plan_phase_1_harden", "target": "docs_pla