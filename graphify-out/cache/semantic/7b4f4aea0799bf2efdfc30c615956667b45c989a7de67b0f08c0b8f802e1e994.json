{"nodes": [{"id": "docs_pre_submission_checklist_pre_submission_checklist", "label": "GJournal Pre-Submission Checklist", "file_type": "document", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pre_submission_checklist_applinks", "label": "AppLinks (privacy policy + support URLs)", "file_type": "concept", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placeholder example.com URLs are deliberate rather than guessed; AppLinks.hasUnconfiguredLinks surfaces a DEBUG-only Settings warning until real values are supplied. Unchanged they cause a Guideline 5.1.1 rejection."}, {"id": "docs_pre_submission_checklist_bundle_identifier", "label": "Bundle Identifier (GJ.GJournal placeholder)", "file_type": "concept", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bundle ID becomes permanent once registered in App Store Connect, so it must be fixed before the first upload, not before release."}, {"id": "docs_pre_submission_checklist_iap_product", "label": "App Store Connect IAP Product (com.gjournal.insights)", "file_type": "concept", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GJournal.storekit is a local test file excluded from the shipping bundle; without a real non-consumable, loadProducts() returns nothing and the paywall degrades to Store Unavailable."}, {"id": "docs_pre_submission_checklist_ipad_support", "label": "iPad Support Decision (TARGETED_DEVICE_FAMILY)", "file_type": "concept", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setting the family to \"1\" (iPhone only) is the cheap safe answer for v1.0 \u2014 Apple tests on iPad and rejects stretched layouts; iPad can be added later without penalty."}, {"id": "docs_pre_submission_checklist_deployment_target", "label": "iOS Deployment Target (18.0 vs 17.0)", "file_type": "concept", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SwiftData shipped in iOS 17 and no API was identified as needing 18.0; staying at 18.0 needlessly excludes the iPhone XR/XS generation."}, {"id": "docs_pre_submission_checklist_crisis_directory", "label": "CrisisDirectory (verified helpline numbers)", "file_type": "concept", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only five confidently verified lines are hardcoded; every other region gets web directories only, enforced by testUnknownRegionNeverShowsARegionSpecificNumber, because a renumbered crisis line is the worst possible bug in this app."}, {"id": "docs_pre_submission_checklist_physical_device_pass", "label": "Physical-Device Verification Pass", "file_type": "concept", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Face ID/Touch ID, PBKDF2 350k-iteration main-thread timing, and MetricKit crash diagnostics cannot be proven in the simulator."}, {"id": "docs_pre_submission_checklist_no_icloud_sync", "label": "No iCloud Sync (JSON export/import only)", "file_type": "rationale", "source_file": "docs/PRE_SUBMISSION_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping backup as local JSON share-sheet export is wha